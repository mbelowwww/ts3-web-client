# Веб-сервер (гейтвей)
PORT=3000

# TS3 ServerQuery (админка) — порт 10011 (raw/telnet) или 10022 (ssh).
# 10011/raw — то, что публикует docker-compose.yml и docker-compose.prod.yml
# по умолчанию для образа teamspeak:latest; менять нужно только если
# используете другой/уже существующий TS3-сервер с иной настройкой.
TS3_HOST=127.0.0.1
TS3_QUERY_PORT=10011
TS3_QUERY_PROTOCOL=raw
TS3_QUERY_USER=serveradmin
TS3_QUERY_PASSWORD=changeme
TS3_QUERY_NICKNAME=WebAdminQuery

# TS3 голосовой (виртуальный) сервер — порт по умолчанию 9987
TS3_VOICE_HOST=127.0.0.1
TS3_VOICE_PORT=9987

# Пароль подключения к серверу (не ServerQuery). Отдаётся TS3 при заходе моста
# и одновременно служит единственным паролем входа на веб-страницу (HTTP Basic Auth).
TS3_SERVER_PASSWORD=changeme

# Префикс ника для голосовых мостов, поднимаемых на каждого веб-юзера
TS3_BRIDGE_NICKNAME_PREFIX=Web
