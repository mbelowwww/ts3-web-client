{
  "name": "ts3web",
  "version": "0.1.0",
  "description": "Веб-клиент для TeamSpeak 3 — админка (ServerQuery) + голос (WebRTC)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@honeybbq/teamspeak-client": "^0.2.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.0",
    "ts3-nodejs-library": "^3.5.3",
    "werift": "^0.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "ssh2@1.17.0": true
  }
}
